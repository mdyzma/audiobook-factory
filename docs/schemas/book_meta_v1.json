{
  "$defs": {
    "ChapterRef": {
      "additionalProperties": false,
      "properties": {
        "chunk_count": {
          "minimum": 0,
          "title": "Chunk Count",
          "type": "integer"
        },
        "first_chunk": {
          "minimum": 0,
          "title": "First Chunk",
          "type": "integer"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "index",
        "title",
        "first_chunk",
        "chunk_count"
      ],
      "title": "ChapterRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What `book.json` holds. Chunks live beside it in chunks.jsonl.",
  "properties": {
    "author": {
      "default": "Unknown",
      "title": "Author",
      "type": "string"
    },
    "cast": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "role -> voice name, as resolved when the book was chunked",
      "title": "Cast",
      "type": "object"
    },
    "chapters": {
      "items": {
        "$ref": "#/$defs/ChapterRef"
      },
      "title": "Chapters",
      "type": "array"
    },
    "chunk_count": {
      "default": 0,
      "minimum": 0,
      "title": "Chunk Count",
      "type": "integer"
    },
    "est_hours": {
      "default": 0.0,
      "minimum": 0,
      "title": "Est Hours",
      "type": "number"
    },
    "language": {
      "default": "pl",
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "slug": {
      "minLength": 1,
      "title": "Slug",
      "type": "string"
    },
    "source_file": {
      "default": "",
      "title": "Source File",
      "type": "string"
    },
    "source_sha256": {
      "default": "",
      "title": "Source Sha256",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "voice": {
      "default": "",
      "title": "Voice",
      "type": "string"
    }
  },
  "required": [
    "slug",
    "title"
  ],
  "title": "BookMeta",
  "type": "object"
}
