{
  "$defs": {
    "RenderFailure": {
      "properties": {
        "attempts": {
          "default": 1,
          "description": "How many times it was tried before giving up",
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "error": {
          "title": "Error",
          "type": "string"
        },
        "kind": {
          "default": "fragment",
          "description": "fragment | voice | model | unknown. A voice or model fault is the run's, not this fragment's, and repeats for every one",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "error"
      ],
      "title": "RenderFailure",
      "type": "object"
    }
  },
  "description": "Written after every synthesis run, real or dry.\n\nFailures used to go to a text file that was easy to miss. This is the\nrecord of what a run actually produced.",
  "properties": {
    "audio_sec": {
      "default": 0.0,
      "minimum": 0,
      "title": "Audio Sec",
      "type": "number"
    },
    "cast": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Cast",
      "type": "object"
    },
    "chunks_rendered": {
      "default": 0,
      "minimum": 0,
      "title": "Chunks Rendered",
      "type": "integer"
    },
    "chunks_retried": {
      "default": 0,
      "description": "Succeeded only after a retry, worth a listen",
      "minimum": 0,
      "title": "Chunks Retried",
      "type": "integer"
    },
    "chunks_skipped": {
      "default": 0,
      "description": "Already had audio",
      "minimum": 0,
      "title": "Chunks Skipped",
      "type": "integer"
    },
    "chunks_total": {
      "default": 0,
      "minimum": 0,
      "title": "Chunks Total",
      "type": "integer"
    },
    "device": {
      "default": "",
      "title": "Device",
      "type": "string"
    },
    "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
    },
    "elapsed_sec": {
      "default": 0.0,
      "minimum": 0,
      "title": "Elapsed Sec",
      "type": "number"
    },
    "engine": {
      "default": "",
      "title": "Engine",
      "type": "string"
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/RenderFailure"
      },
      "title": "Failures",
      "type": "array"
    },
    "finished_at": {
      "default": "",
      "title": "Finished At",
      "type": "string"
    },
    "model": {
      "default": "",
      "description": "Registry id, with revision where pinned",
      "title": "Model",
      "type": "string"
    },
    "ok": {
      "readOnly": true,
      "title": "Ok",
      "type": "boolean"
    },
    "realtime_factor": {
      "description": "Seconds of audio produced per second of wall clock.",
      "readOnly": true,
      "title": "Realtime Factor",
      "type": "number"
    },
    "sample_rate": {
      "default": 0,
      "description": "The engine's native rate, before any resampling",
      "minimum": 0,
      "title": "Sample Rate",
      "type": "integer"
    },
    "schema_version": {
      "default": 6,
      "title": "Schema Version",
      "type": "integer"
    },
    "slug": {
      "minLength": 1,
      "title": "Slug",
      "type": "string"
    },
    "started_at": {
      "default": "",
      "title": "Started At",
      "type": "string"
    },
    "voice": {
      "default": "",
      "title": "Voice",
      "type": "string"
    }
  },
  "required": [
    "slug",
    "realtime_factor",
    "ok"
  ],
  "title": "RenderReport",
  "type": "object"
}
